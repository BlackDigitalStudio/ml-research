[Unit]
Description=AxB h150 Rust engine (XRP, SHADOW — decisions only, no exec socket; split-VM deploy, funding anchor via recorder GCS/REST fallback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=delmi
Group=delmi
Environment=HOME=/home/delmi
Environment=MODE=shadow
Environment=SYMK=XRP
Environment=SIGNAL_SYM=xrpusdt
Environment=TRADE_BUDGET=5
Environment=WORKDIR=/home/delmi/axb_h150
Environment=RECEV_DIR=research_runs/_recev_h150anch_XRP
Environment=BUNDLE_DIR=research_runs/deploy_h150/XRP
WorkingDirectory=/home/delmi/axb_h150
ExecStartPre=/usr/bin/python3 /home/delmi/axb_boot.py
ExecStart=/home/delmi/axb_engine
Restart=always
RestartSec=5
Nice=1
MemoryMax=2G

[Install]
WantedBy=multi-user.target
