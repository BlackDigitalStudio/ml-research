[Unit]
Description=AxB order-execution sidecar (DOGEUSDC maker lifecycle + decision-log GCS upload; Unix socket for axb_engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=delmi
Group=delmi
Environment=HOME=/home/delmi
Environment=MODE=live
Environment=SYMK=DOGE
Environment=EXEC_SYM=DOGEUSDC
Environment=TRADE_BUDGET=10
Environment=SIZE_FRAC=0.5
Environment=MAX_CONC=1
Environment=WORKDIR=/home/delmi/axb_h150
Environment=SHADOW_GCS=research_runs/axb_shadow_h150/DOGE
WorkingDirectory=/home/delmi/axb_h150
ExecStart=/home/delmi/venv/bin/python3 /home/delmi/axb_exec.py
Restart=always
RestartSec=5
Nice=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
